# Copy to .env and fill in. .env is gitignored -- never commit it.

# --- app ---
APP_HOST=127.0.0.1
APP_PORT=8090
DATA_DIR=./data

# Single shared password, second layer behind Cloudflare Access.
# Generate the hash:  uv run python -c "import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt()).decode())"
APP_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# --- llama-server (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:8084/v1
LLM_API_KEY=
LLM_MODEL=Qwen-Coder

# --- tts ---
KOKORO_MODEL_PATH=./models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=./models/voices-v1.0.bin
KOKORO_VOICE=af_heart

# --- upload hardening (section 8 of the spec) ---
MAX_UPLOAD_BYTES=104857600
MAX_PAGES=500
PARSE_TIMEOUT_SECONDS=120
